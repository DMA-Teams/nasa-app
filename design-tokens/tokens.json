{
  "$description": "Tokens de diseño de Space Apps Starter. Fuente única: edita este archivo y corre `npm run tokens` para regenerar design-tokens/build/. Los temas no usan el logo ni la marca de NASA.",
  "shared": {
    "font": {
      "display": { "family": "Space Grotesk", "fallback": "ui-sans-serif, system-ui, sans-serif", "google": "Space+Grotesk:wght@500;700" },
      "body": { "family": "Inter", "fallback": "ui-sans-serif, system-ui, sans-serif", "google": "Inter:wght@400;500;600" },
      "mono": { "family": "JetBrains Mono", "fallback": "ui-monospace, SFMono-Regular, monospace", "google": "JetBrains+Mono:wght@400;600" }
    },
    "fontSize": { "xs": "0.75rem", "sm": "0.875rem", "base": "1rem", "lg": "1.125rem", "xl": "1.375rem", "2xl": "1.75rem", "3xl": "2.25rem", "hero": "3rem" },
    "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px", "12": "48px", "16": "64px" },
    "radius": { "sm": "6px", "md": "10px", "lg": "16px", "pill": "999px" },
    "motion": {
      "easeOut": "cubic-bezier(0.23, 1, 0.32, 1)",
